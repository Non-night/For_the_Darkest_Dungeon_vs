<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="For_the_Darkest_Dungeon.47e77e32-9afb-49d3-aaa2-628132f2de5b" Version="3.1.7" Language="zh-CN" Publisher="No_night" />
    <DisplayName>For The Darkest Dungeon</DisplayName>
    <Description xml:space="preserve">实现了effects.darkest，info.darkest/art.darkest/override.darkest的高亮和自动补全，并且现有一定的语法检查功能
实现了colours.darkest的自动着色和调色盘功能
高亮颜色大多数随主题自动变化，全部可以自行定义，在工具→选项→环境→字体与颜色，Darkest开头的部分就是
colours的自动渲染和调色盘功能可在设置中关闭
注释快捷键功能也可以在设置中关闭
设置中可以设置对布尔值的大小写偏好

注意，若脚本对你的代码进行了报错，未必说明你的代码就是错误的，只是可能存在一些代码表中不存在的情况或者某些有可能存在歧义的写法</Description>
    <Tags>Mod, Darkest Dungeon</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.5,)" d:Source="Manual" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" DisplayName="Visual Studio core editor" Version="[17.0,18.0)" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" d:Source="Project" d:ProjectName="%CurrentProject%" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|%CurrentProject%|" d:Source="Project" d:ProjectName="%CurrentProject%" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="DarkestFileExtension.pkgdef" d:Source="File" />
  </Assets>
</PackageManifest>